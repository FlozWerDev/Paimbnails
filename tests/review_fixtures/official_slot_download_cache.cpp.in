// A fresh instance models a restarted process without keeping the RAM map.
#define private public
@@function|src/features/official-slots/services/SlotLevels.hpp|class SlotDownloads :@@;
#undef private
@@function|src/features/official-slots/services/SlotLevels.cpp|SlotDownloads& SlotDownloads::get(@@
@@function|src/features/official-slots/services/SlotLevels.cpp|void SlotDownloads::fetch(@@
@@function|src/features/official-slots/services/SlotLevels.cpp|void SlotDownloads::startNext(@@
@@function|src/features/official-slots/services/SlotLevels.cpp|void SlotDownloads::requestNetwork(@@
@@function|src/features/official-slots/services/SlotLevels.cpp|GJGameLevel* SlotDownloads::cachedLevel(@@
@@function|src/features/official-slots/services/SlotLevels.cpp|void SlotDownloads::rememberLevel(@@
@@function|src/features/official-slots/services/SlotLevels.cpp|void SlotDownloads::finishPending(@@
@@function|src/features/official-slots/services/SlotLevels.cpp|void SlotDownloads::levelDownloadFinished(@@
@@function|src/features/official-slots/services/SlotLevels.cpp|void SlotDownloads::levelDownloadFailed(@@
}

int main() {
    using namespace paimon::officialslots;
    auto directory = std::filesystem::temp_directory_path() / "paim-slot-download-cache-regression";
    std::filesystem::remove_all(directory);
    Mod::get()->directory = directory;
    auto* glm = GameLevelManager::get();
    LevelDownloadDelegate previous;
    glm->m_levelDownloadDelegate = &previous;
    GJGameLevel original;
    original.m_levelID = 123456;
    original.m_levelString = "downloaded payload";
    original.m_songID = 1516520;
    original.m_songIDs = "1516520,5678";
    original.m_sfxIDs = "12,34";
    original.m_stars = 10;
    original.m_demon = 1;
    original.m_demonDifficulty = 6;
    original.m_isEpic = 3;
    glm->saved[123456] = &original;
    SlotDownloads first;
    int completed = 0;
    first.fetch(123456, [&](auto* result) { assert(result == &original); ++completed; });
    assert(completed == 1 && glm->network.empty());
    drain();
    glm->saved.clear();
    first.fetch(123456, [&](auto* result) { assert(result == &original); ++completed; });
    assert(completed == 2 && glm->network.empty()); // A page rebuild needs no network.

    SlotDownloads restarted;
    GJGameLevel* restored = nullptr;
    restarted.fetch(123456, [&](auto* result) { restored = result; ++completed; });
    restarted.fetch(123456, [&](auto* result) { assert(result == restored); ++completed; });
    assert(completed == 2); // Reading persisted data is asynchronous, coalesced by source ID.
    drain();
    assert(completed == 4 && restored && glm->network.empty());
    assert(restored->m_levelString == original.m_levelString);
    assert(restored->m_songID == 1516520 && restored->m_songIDs == original.m_songIDs);
    assert(restored->m_sfxIDs == original.m_sfxIDs && !restored->m_levelNotDownloaded);
    assert(restored->m_stars.value() == 10 && restored->m_demon.value() == 1);
    assert(restored->m_demonDifficulty == 6 && restored->m_isEpic == 3); // Import prefills survive restarts.
    restarted.fetch(123456, [&](auto* result) { assert(result == restored); ++completed; });
    assert(completed == 5 && paimon::ThreadTracker::get().workers.empty());

    GJGameLevel networkLevel;
    networkLevel.m_levelID = 456789;
    networkLevel.m_levelString = "network payload";
    restarted.fetch(456789, [&](auto* result) { assert(result == &networkLevel); ++completed; });
    restarted.fetch(456789, [&](auto* result) { assert(result == &networkLevel); ++completed; });
    drain();
    assert(glm->network == std::vector<int>{456789});
    assert(glm->m_levelDownloadDelegate == &restarted);
    restarted.levelDownloadFinished(&original); // A foreign native download cannot finish ours.
    assert(completed == 5);
    restarted.levelDownloadFinished(&networkLevel);
    assert(completed == 7 && glm->m_levelDownloadDelegate == &previous);
    drain();
    restarted.fetch(456789, [&](auto* result) { assert(result == &networkLevel); ++completed; });
    assert(completed == 8 && glm->network.size() == 1);
    SlotDownloads secondRestart;
    secondRestart.fetch(456789, [&](auto* result) { assert(result && result->m_levelString == "network payload"); ++completed; });
    drain();
    assert(completed == 9 && glm->network.size() == 1);

    restarted.fetch(999999, [&](auto* result) { assert(!result); ++completed; });
    drain();
    restarted.levelDownloadFailed(-1);
    assert(completed == 10);
    restarted.fetch(999999, [](auto*) {});
    drain();
    assert(glm->network.size() == 3); // Failed fetches remain retryable.
    restarted.levelDownloadFailed(-1);
    std::filesystem::remove_all(directory);
    std::cout << "RAM/disk reuse across restarts, coalescing, delegate restore, no repeated download passed\n";
}
