inline std::vector<std::function<void()>> workers, mainJobs;
void runJob(std::vector<std::function<void()>>& jobs) {
    auto job = std::move(jobs.front()); jobs.erase(jobs.begin()); job();
}
struct Loader {
    static Loader* get() { static Loader loader; return &loader; }
    void queueInMainThread(std::function<void()> job) { mainJobs.push_back(std::move(job)); }
};
namespace paimon {
bool isRuntimeShuttingDown() { return false; }
struct ThreadTracker {
    bool reject = false, throwOnSpawn = false;
    static ThreadTracker& get() { static ThreadTracker tracker; return tracker; }
    bool spawn(std::function<void()> job) {
        if (throwOnSpawn) throw std::runtime_error("worker unavailable");
        if (reject) return false;
        workers.push_back(std::move(job)); return true;
    }
};
namespace assets { std::filesystem::path pathFromUtf8(std::string const& path) { return std::filesystem::path(path); } }
namespace file {
bool writeAtomically(std::filesystem::path const& path, std::string const& value) {
    std::filesystem::create_directories(path.parent_path());
    std::ofstream stream(path); stream << value; return static_cast<bool>(stream);
}
}
}
namespace geode::utils {
namespace string { std::string pathToString(std::filesystem::path const& path) { return path.string(); } }
struct Number { std::optional<int> number; explicit operator bool() const { return number.has_value(); } bool isOk() const { return number.has_value(); } int unwrap() const { return *number; } };
template<class T> Number numFromString(std::string const& value) {
    try { return {{std::stoi(value)}}; } catch (...) { return {}; }
}
namespace file {
struct ReadResult { std::optional<std::string> value; explicit operator bool() const { return value.has_value(); } std::string unwrap() const { return *value; } };
ReadResult readString(std::filesystem::path const& path) {
    std::ifstream stream(path); if (!stream) return {};
    return {{std::string(std::istreambuf_iterator<char>(stream), {})}};
}
}
}
namespace coverlog { template<class... A> void info(A const&...) {} template<class... A> void warn(A const&...) {} }
std::filesystem::path saveRoot;
struct Mod { static Mod* get() { static Mod mod; return &mod; } std::filesystem::path getSaveDir() { return saveRoot; } };

struct SongCoverCache {
    using CoversCallback = std::function<void(std::vector<std::string> const&, bool)>;
    struct CoverEntry { int levelID = 0; std::string name, path; };
    struct SongManifest { std::vector<int> levelIds; std::vector<std::string> coverPaths; std::unordered_map<int, std::string> levelNames; };
    struct DiskCoverSnapshot { std::optional<SongManifest> manifest; std::vector<std::string> legacyPaths; std::unordered_map<std::string, double> negativeEntries; };
    struct PendingDiskLookup { std::uint64_t serial = 0, version = 0; std::vector<CoversCallback> callbacks; };
    struct PendingBatch { int songID = 0; };
    mutable std::unordered_set<int> m_loggedMissingManifests;
    mutable std::unordered_map<int, std::optional<SongManifest>> m_manifestMemo;
    mutable std::unordered_map<int, std::vector<std::string>> m_legacyMemo;
    mutable std::unordered_map<int, std::uint64_t> m_manifestVersions;
    mutable std::optional<std::unordered_map<std::string, double>> m_negativeMemo;
    std::unordered_map<int, PendingDiskLookup> m_pendingDiskLookups;
    std::unordered_map<int, std::vector<CoversCallback>> m_deferredCallbacks;
    std::vector<PendingBatch> m_queue;
    std::uint64_t m_diskLookupSerial = 0;
    int m_targetSongID = 0;
    void cancelDebounce() {}
    static SongCoverCache& get() { static SongCoverCache cache; return cache; }
    std::filesystem::path getCoversDir() const; std::filesystem::path getSongDir(int) const;
    static DiskCoverSnapshot readDiskCoverSnapshot(std::filesystem::path const&, int);
    void requestCachedCoversAsync(int, CoversCallback);
    void finishCachedCoverLookup(int, std::uint64_t, std::optional<DiskCoverSnapshot>);
    static void validateCoverPathsAsync(std::vector<std::string>, CoversCallback);
    std::vector<std::string> peekCachedCoverPaths(int) const;
    std::vector<CoverEntry> peekCachedCoverEntries(int) const;
    bool loadManifest(int, SongManifest&) const;
    void saveManifest(int, std::vector<int> const&, std::vector<std::string> const&, std::unordered_map<int, std::string> const&) const;
    std::vector<std::string> getCachedCoverPaths(int) const;
    std::vector<CoverEntry> getCachedCoverEntries(int) const;
    void cancelPending(int);
};
@@function|src/features/menu-music/services/SongCoverCache.cpp|std::filesystem::path SongCoverCache::getCoversDir()@@
