struct GJSearchObject {
 int m_searchType=0, m_songID=5, m_folder=0, m_demonFilter=0, m_searchMode=0;
 std::string m_searchQuery="test", m_difficulty="-1", m_length="-1";
 bool m_starFilter=false, m_noStarFilter=false, m_uncompletedFilter=false,
 m_completedFilter=false, m_featuredFilter=false, m_originalFilter=false,
 m_twoPlayerFilter=false, m_coinsFilter=false, m_epicFilter=false,
 m_songFilter=true, m_legendaryFilter=false, m_mythicFilter=false,
 m_customSongFilter=false;
};
@@function|src/features/info-suite/services/SearchObjectBuilder.hpp|inline std::string searchKey(@@
int main() {
 GJSearchObject base;
 for(int i=0;i<4;i++) {
   auto other=base;
   if(i==0) other.m_legendaryFilter=true;
   if(i==1) other.m_mythicFilter=true;
   if(i==2) other.m_customSongFilter=true;
   if(i==3) other.m_searchMode=1;
   assert(searchKey(&base)!=searchKey(&other));
 }
 GJSearchObject left=base,right=base;
 left.m_searchQuery="a|b";left.m_difficulty="c";
 right.m_searchQuery="a";right.m_difficulty="b|c";
 assert(searchKey(&left)!=searchKey(&right));
 std::cout << "PASS: search_identity\n";
}
