#include "src/features/thumbnails/services/DiskManifest.hpp"
#include <matjson.hpp>
#include <cassert>
#include <condition_variable>
#include <filesystem>
#include <fstream>
#include <future>
#include <thread>
#include <cstdio>
#include <cstdlib>
#undef assert
#define assert(value) do { if (!(value)) { std::fprintf(stderr, "assertion failed at line %d: %s\n", __LINE__, #value); std::abort(); } } while (false)
using namespace std::chrono_literals;

std::mutex diskMutex;
std::condition_variable diskReady;
bool entered = false, released = false, failWrite = false;
std::vector<std::string> published;
namespace paimon::file {
bool writeAtomically(std::filesystem::path const&, std::string const& data) {
    std::unique_lock lock(diskMutex);
    entered = true; diskReady.notify_all();
    assert(diskReady.wait_for(lock, 3s, [] { return released; }));
    if (failWrite) return false;
    published.push_back(data);
    return true;
}
}
