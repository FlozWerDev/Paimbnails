struct LocalThumbnailViewPopup {
    CCNode *m_mainLayer = nullptr, *m_clippingNode = nullptr, *m_imageStencil = nullptr,
        *m_imageBorder = nullptr, *m_imageBackdrop = nullptr, *m_thumbnailSprite = nullptr,
        *m_buttonMenu = nullptr, *m_sidebarBg = nullptr, *m_infoBar = nullptr,
        *m_playBtn = nullptr, *m_playBtnMenu = nullptr, *m_hideChromeBtn = nullptr,
        *m_refreshBtn = nullptr, *m_leftArrow = nullptr, *m_rightArrow = nullptr;
    struct HeaderButtonPose { WeakRef<CCNode> button; CCPoint position; };
    std::vector<HeaderButtonPose> m_headerButtonPoses;
    std::vector<int> m_thumbnails, m_suggestions, m_localThumbPaths;
    std::vector<int> m_touches;
    paimon::thumbviewer::FocusTransition m_focusTransition;
    bool m_chromeHidden = false, m_hasFocusImagePose = false,
        m_refreshCooldownActive = false, m_isDownloading = false;
    float m_viewWidth = 0.f, m_viewHeight = 0.f, m_initialScale = 1.f,
        m_minScale = 1.f, m_maxScale = 4.f, m_collapsedImageScale = 1.f, m_expandedImageScale = 1.f;
    CCPoint m_collapsedImagePosition, m_expandedImagePosition;
    void schedule(int) {}
    void unschedule(int) {}
    void clampSpritePosition() {}
    void resetZoomGestureState() {}
    void updateRefreshButtonState() {}
    void prepareFocusImagePose(bool);
    void applyFocusLayout();
    void setChromeVisible(bool);
    void tickFocus(float);
};
@@function|src/features/thumbnails/ui/LocalThumbnailViewPopup.cpp|void LocalThumbnailViewPopup::prepareFocusImagePose(@@
