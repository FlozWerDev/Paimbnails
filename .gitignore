# Ignore everything
*

# Keep this file
!.gitignore

# Keep Logo.png
!Logo.png

# Keep all .md files
!*.md

# Keep mod.json
!mod.json

# Keep CMakeLists.txt
!CMakeLists.txt

# Keep src/ and all its contents
!src/
!src/**

# Keep resources/ and all its contents
!resources/
!resources/**

# Keep .github/ and all its contents
!.github/
!.github/**

# Keep the Render collaboration server (its own .gitignore excludes secrets
# and dependencies).
!collab-editor-render/
!collab-editor-render/**

# Keep the Cloudflare Worker source/config, but not local Wrangler state or
# generated dry-run bundles.
!cloudflare-server/
cloudflare-server/*
!cloudflare-server/paimon-thumbnails-server.js
!cloudflare-server/wrangler.toml

# Keep installer/ scripts only (not binaries)
!installer/
!installer/**
installer/*.exe
installer/*.geode
installer/banner.bmp

# Exclude AI/agent config files
AGENTS.md
CLAUDE.md
post.md
.kiro/
