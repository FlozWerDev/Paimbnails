namespace geode {
struct Mod {
    static Mod* get() { static Mod mod; return &mod; }
    std::filesystem::path getSaveDir() { return std::filesystem::current_path() / "official-slot-test"; }
};
namespace log { template<class... T> void warn(char const*, T const&...) {} }
namespace utils {
template<class T> Result<T> numFromString(std::string const& text) {
    T value{};
    auto [end, error] = std::from_chars(text.data(), text.data() + text.size(), value);
    if (error != std::errc{} || end != text.data() + text.size()) return Err("invalid integer");
    return Ok(value);
}
namespace string { std::string pathToString(std::filesystem::path const& path) { return path.string(); } }
namespace file {
Result<std::string> readString(std::filesystem::path const& path) {
    std::ifstream stream(path);
    if (!stream) return Err("cannot read");
    return Ok(std::string(std::istreambuf_iterator<char>(stream), {}));
}
}
}
namespace prelude { using namespace geode; using namespace geode::utils; }
}
namespace paimon::file {
bool writeAtomically(std::filesystem::path const& path, std::string const& text) {
    std::ofstream stream(path);
    stream << text;
    return stream.good();
}
}
