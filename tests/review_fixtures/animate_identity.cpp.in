struct CCString {
    std::string text;
    static CCString* create(std::string value){return new CCString{std::move(value)};}
    char const* getCString()const{return text.c_str();}
};
template<class T>T typeinfo_cast(CCString* value){return static_cast<T>(value);}
struct GJGameLevel : TestLifetime {
    int m_levelID=0;
    std::string m_levelName="Demo";
    std::unique_ptr<CCString> identity;
    CCString* getUserObject(char const*){return identity.get();}
    void setUserObject(char const*,CCString* value){identity.reset(value);}
};
struct Document {std::vector<int> clips;};
inline constexpr char const* kLevelIdentityKey="test-animate-identity";
std::filesystem::path root;
std::unordered_map<std::string,Document> docs;
std::filesystem::path pathFor(std::string const& key){return root/(key+".json");}
Document loadDocument(std::string const& key){return docs[key];}
bool saveDocument(std::string const& key,Document const& doc){
    std::filesystem::create_directories(root);
    docs[key]=doc;std::ofstream(pathFor(key))<<"fixture";return true;
}
struct log {template<class...T>static void warn(T&&...){} };
struct LocalLevelManager {
    std::vector<GJGameLevel*> levels;
    std::vector<GJGameLevel*>* m_localLevels=&levels;
    static LocalLevelManager* get(){static LocalLevelManager value;return &value;}
};
