namespace cocos2d {
struct CCNode {
    inline static unsigned nextID = 0;
    unsigned m_uID = ++nextID;
    int references = 1;
    CCNode* parent = nullptr;
    virtual ~CCNode() = default;
    CCNode* getParent() { return parent; }
    void retain() { ++references; }
    void release() { if (--references == 0) delete this; }
};
struct CCScene : CCNode {
    bool* loadNext = nullptr;
    explicit CCScene(bool* ready = nullptr) : loadNext(ready) {}
    ~CCScene() override { if (loadNext) *loadNext = true; }
};
struct CCTransitionScene : CCScene {};
struct CCMenuItem : CCNode { bool isEnabled() { return true; } };
struct CCDirector {
    CCScene* scene = nullptr;
    static CCDirector* get() { static CCDirector director; return &director; }
    CCScene* getRunningScene() { return scene; }
};
}
using namespace cocos2d;
template<class To, class From> To typeinfo_cast(From* object) { return dynamic_cast<To>(object); }

// Geode 5.11 WeakRefPool retains its managed object until a weak handle is
// locked/destroyed. Dropping a handle via move assignment alone doesn't forget it.
template<class T> struct Ref {
    T* object;
    explicit Ref(T* value) : object(value) { if (object) object->retain(); }
    ~Ref() { if (object) object->release(); }
    T* data() const { return object; }
    explicit operator bool() const { return object != nullptr; }
};
template<class T> class WeakRef {
    struct Controller { T* object; };
    inline static std::unordered_map<T*, std::shared_ptr<Controller>> pool;
    std::shared_ptr<Controller> controller;
    static void forget(T* object) {
        if (!object || !pool.contains(object)) return;
        pool.at(object)->object = nullptr;
        pool.erase(object);
        object->release();
    }
    void check() const {
        if (controller && controller->object && controller->object->references == 1)
            forget(controller->object);
    }
public:
    WeakRef() = default;
    WeakRef(T* object) {
        if (!object) return;
        if (!pool.contains(object)) {
            object->retain();
            pool[object] = std::make_shared<Controller>(Controller{object});
        }
        controller = pool.at(object);
    }
    WeakRef(WeakRef const&) = default;
    WeakRef(WeakRef&&) = default;
    ~WeakRef() {
        check();
        if (controller && controller.use_count() == 2) forget(controller->object);
    }
    WeakRef& operator=(WeakRef&& other) noexcept {
        controller = std::move(other.controller);
        return *this;
    }
    WeakRef& operator=(T* object) {
        assert(!object); // Only the null assignment path is needed here.
        controller = nullptr;
        return *this;
    }
    Ref<T> lock() const { check(); return Ref<T>(controller ? controller->object : nullptr); }
};
struct Loader {
    std::vector<std::function<void()>> queued;
    static Loader* get() { static Loader loader; return &loader; }
    void queueInMainThread(std::function<void()> callback) { queued.push_back(std::move(callback)); }
    void flush() { auto callbacks = std::exchange(queued, {}); for (auto& callback : callbacks) callback(); }
};

