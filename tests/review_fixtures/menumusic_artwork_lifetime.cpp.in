struct CCObject {};
struct MenuMusicLibrary {
    bool pending = true;
    static MenuMusicLibrary& get() { static MenuMusicLibrary library; return library; }
    bool isSyncingDownloadedSongs() const { return pending; }
};
struct MenuMusicPopup : CCNode {
    CCNode backdrop;
    CCNode* m_fullscreenBackdrop = &backdrop;
    CCSprite* m_fullscreenBlur = nullptr;
    std::uint64_t m_fullscreenBlurGen = 0;
    bool m_fullscreenBlurPending = false;
    std::string m_lastCoverPath;
    int builds = 0;
    int playbackRequests = 0;
    bool m_playAfterSync = false;
    void onModeLibrary(CCObject*) { ++playbackRequests; }
    void finishPendingPlayback();
    void buildFullscreenBlur(CCTexture2D*, std::uint64_t) { ++builds; }
    void applyFullscreenCover(std::string const&);
};
@@function|src/features/menu-music/ui/MenuMusicPopup.cpp|void MenuMusicPopup::applyFullscreenCover(@@
@@function|src/features/menu-music/ui/MenuMusicPopup.cpp|void MenuMusicPopup::finishPendingPlayback()@@

int main() {
    auto& requests = paimon::image::requests;
    CCTexture2D texture;
    auto hero = std::make_unique<CoverHero>();
    hero->setPausedAppearance(true);
    hero->setCoverFromPath("first"); hero->setCoverFromPath("first");
    assert(requests.size() == 1 && !hero->m_coverSprite);
    hero->setCoverFromPath("second");
    requests[0](&texture); assert(!hero->m_coverSprite);
    requests[1](&texture);
    assert(hero->m_coverSprite && hero->m_coverSprite->opacity == 200 && hero->m_coverSprite->color.r == 130);
    hero->setCoverFromPath(""); assert(!hero->m_coverSprite && hero->fallback.visible);
    hero->setCoverFromPath("closed");
    hero->onExit(); requests[2](&texture); assert(!hero->m_coverSprite);
    hero.reset(); requests[2](&texture);

    VinylDisc disc;
    disc.setPausedAppearance(true); disc.setCoverFromPath("disc");
    requests[3](&texture);
    assert(disc.m_coverSprite && disc.m_coverSprite->opacity == 200 && disc.m_coverSprite->color.r == 130);
    assert(texture.references == 2);
    disc.applyCoverTexture(&texture);
    assert(texture.references == 2);
    disc.setCoverFromPath("");
    assert(texture.references == 1 && !disc.m_currentCoverTexture);

    CoverBlurBackground background;
    background.setCoverFromPath("cover"); background.setCoverFromPath("cover");
    assert(requests.size() == 5);
    background.setCoverFromPath("changed");
    requests[4](&texture); assert(background.builds == 0);
    background.onExit(); requests[5](&texture); assert(background.builds == 0);

    MenuMusicPopup popup;
    popup.applyFullscreenCover("cover"); popup.applyFullscreenCover("cover");
    popup.applyFullscreenCover("changed");
    // The fullscreen backdrop was removed; artwork must not start hidden work.
    assert(requests.size() == 6 && popup.builds == 0);
    popup.m_playAfterSync = true;
    popup.finishPendingPlayback(); assert(popup.playbackRequests == 0);
    MenuMusicLibrary::get().pending = false;
    popup.finishPendingPlayback(); assert(popup.playbackRequests == 1 && !popup.m_playAfterSync);
    popup.finishPendingPlayback(); assert(popup.playbackRequests == 1);
    requests.clear();
}
