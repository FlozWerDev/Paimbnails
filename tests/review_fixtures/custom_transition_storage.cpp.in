#include <algorithm>
#include <cassert>
#include <cmath>
#include <limits>
#include <matjson.hpp>
#include "src/features/transitions/services/TransitionTypes.hpp"
#include "src/features/transitions/services/TransitionEvaluation.hpp"
#include "src/utils/JsonHelper.hpp"

class TransitionManager {
public:
    static TransitionType typeFromString(std::string const&);
    static std::string typeToString(TransitionType);
    static CommandAction actionFromString(std::string const&);
    static std::string actionToString(CommandAction);
    static TransitionEasing easingFromString(std::string const&);
    static std::string easingToString(TransitionEasing);
    static bool isValidTarget(std::string const&);
    static int sanitizeCommand(TransitionCommand&);
    static int sanitizeCommands(std::vector<TransitionCommand>&);
    static int sanitizeConfig(TransitionConfig&);
    static std::string commandsToJson(std::vector<TransitionCommand> const&);
    static bool commandsFromJson(std::string const&, std::vector<TransitionCommand>&);
};
