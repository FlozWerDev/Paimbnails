int main() {
 LevelTagsClient client; int completed=0;
 client.fetchTags({123},[&](LevelTagMap){++completed;});
 assert(WebHelper::requests.size()==1);
 auto fail=WebHelper::requests[0]; fail(web::WebResponse{});
 assert(completed==1 && !client.m_levelTags.contains(123) && !client.m_dirty);
 client.fetchTags({123},[&](LevelTagMap){++completed;});
 assert(WebHelper::requests.size()==2 && completed==1);
 auto retry=WebHelper::requests.back();retry({true,"[]"});
 assert(!client.m_levelTags.contains(123) && completed==2);
 client.fetchTags({123},[&](LevelTagMap){++completed;});
 auto invalid=WebHelper::requests.back();invalid({true,"invalid JSON"});
 assert(!client.m_levelTags.contains(123) && completed==3);
 client.fetchTags({123},[&](LevelTagMap){++completed;});
 auto valid=WebHelper::requests.back();valid({true,"{}"});
 assert(client.m_levelTags.contains(123) && client.m_dirty && completed==4);
