@@function|src/blur/PopupBlurService.cpp|static void cleanupImpl(@@

int main() {
    CCNode scene;
    CCNode a{&scene, false, 1, 1}, b{&scene, false, 1, 2}, c{&scene, true, 1, 3};
    CCNode popupA, popupB, popupC;
    auto& registry = blurRegistry();
    registry[&popupA] = {&a, &a, &scene};
    registry[&popupB] = {&b, &b, &scene};
    registry[&popupC] = {&c, &c, &scene};

    cleanupImpl(&popupC, 0.f);
    assert(!a.visible && b.visible); // closing the third popup restores only the second
    Loader::get()->drain();
    assert(c.parent == nullptr);

    cleanupImpl(&popupA, 0.f); // removing an obscured popup must not affect the top
    assert(b.visible);
    Loader::get()->drain();
    cleanupImpl(&popupB, 0.f);
    Loader::get()->drain();
    assert(registry.empty());

    a.parent = &scene; b.parent = &scene;
    a.z = 4; b.z = 2;
    registry[&popupA] = {&a, &a, &scene};
    registry[&popupB] = {&b, &b, &scene};
    updateBlurVisibility();
    assert(a.visible && !b.visible); // z takes precedence over insertion order
    a.parent = nullptr;
    updateBlurVisibility();
    assert(b.visible); // orphaned surfaces cannot hide a live popup
    registry.clear();
}
