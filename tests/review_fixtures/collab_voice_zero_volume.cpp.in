struct Mod {
 static Mod* get(){static Mod value;return &value;}
 template<class T> T getSettingValue(char const*) {return static_cast<T>(volume);}
 double volume=0;
};
@@function|src/features/collab-editor/CollabVoice.cpp|float voiceVolume()@@
int main() {
 Mod::get()->volume=0.5; assert(voiceVolume()==0.5f);
 Mod::get()->volume=0; assert(voiceVolume()==0.f);
 Mod::get()->volume=-1; assert(voiceVolume()==0.f);
 Mod::get()->volume=3; assert(voiceVolume()==1.f);
 Mod::get()->volume=std::numeric_limits<double>::quiet_NaN(); assert(voiceVolume()==1.f);
 std::cout << "PASS: collab_voice_zero_volume\n";
}
