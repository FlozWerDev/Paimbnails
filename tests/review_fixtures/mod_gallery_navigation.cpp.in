int main(){
 auto popup=std::make_unique<ModPreviewGalleryPopup>();
 popup->openIndex(1);auto* first=popup->m_sprite;first->complete();assert(first->visible);
 popup->openIndex(2);auto* second=popup->m_sprite;assert(first!=second&&!first->attached);
 second->complete();assert(second->visible&&second->requests==1);
 popup->openIndex(1);auto* pending=popup->m_sprite;
 popup->openIndex(3);auto* current=popup->m_sprite;
 pending->complete();assert(!current->visible);current->complete();assert(current->visible);
