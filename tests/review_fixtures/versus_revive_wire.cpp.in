int main() {
 VsState spent({StateKind::Spent,0,0,5.f}), revive({StateKind::Revive,0,0,5.f});
 assert(VsState::decode(spent.encode()).isOk());
 assert(VsState::decode(revive.encode()).isOk());
 for(unsigned i=0;i<=static_cast<unsigned>(StateKind::Revive);++i) {
  VsState state({static_cast<StateKind>(i),3,42,5.f});
  auto decoded=VsState::decode(state.encode());
  assert(decoded.isOk() && decoded.value->data.kind==static_cast<StateKind>(i));
 }
 auto invalid=revive.encode(); invalid[0]=255;
 assert(!VsState::decode(invalid).isOk());
 assert(!VsState::decode({}).isOk());
 std::cout << "PASS: versus_revive_wire\n";
}
