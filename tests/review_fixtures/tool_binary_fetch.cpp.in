// Exercise the production fetch helper without making network requests.
#define FMT_HEADER_ONLY
#define GEODE_IS_WINDOWS
#include <fmt/format.h>
#include <algorithm>
#include <atomic>
#include <cassert>
#include <chrono>
#include <cstdint>
#include <deque>
#include <filesystem>
#include <functional>
#include <memory>
#include <string>
#include <utility>
#include <vector>

namespace paimon { bool isRuntimeShuttingDown() { return false; } }
namespace geode {
using ByteVector = std::vector<std::uint8_t>;
struct Loader {
    std::deque<std::function<void()>> jobs;
    static Loader* get() { static Loader loader; return &loader; }
    void queueInMainThread(std::function<void()> job) { jobs.push_back(std::move(job)); }
    void flush() {
        while (!jobs.empty()) {
            auto job = std::move(jobs.front());
            jobs.pop_front();
            job();
        }
    }
};
namespace utils::web {
struct WebProgress {
    std::uint64_t downloaded() const { return 512; }
    std::uint64_t downloadTotal() const { return 1024; }
};
struct WebRequest {
    std::function<void(WebProgress const&)> progress;
    WebRequest& timeout(std::chrono::minutes) { return *this; }
    WebRequest& userAgent(std::string const&) { return *this; }
    void onProgress(decltype(progress) callback) { progress = std::move(callback); }
};
struct WebResponse {
    int status = 200;
    ByteVector bytes;
    bool ok() const { return status >= 200 && status < 300; }
    int code() const { return status; }
    ByteVector data() const { return bytes; }
};
}
}
namespace WebHelper {
std::string requestedUrl;
std::function<void(geode::utils::web::WebResponse)> pending;
std::function<void(geode::utils::web::WebProgress const&)> progress;
void dispatch(geode::utils::web::WebRequest&& request, std::string const& method,
              std::string const& url, decltype(pending) callback) {
    assert(method == "GET");
    requestedUrl = url;
    progress = std::move(request.progress);
    pending = std::move(callback);
}
void respond(int status, std::size_t bytes) {
    auto callback = std::move(pending);
    callback({status, geode::ByteVector(bytes)});
}
}

@@source|src/features/menu-music/services/ToolBinaryFetch.hpp@@

struct Progress { std::string stage; float percent; std::string message; };
using ProgressCallback = std::function<void(Progress)>;
using CompleteCallback = std::function<void(bool, std::string)>;

int main() {
    using namespace paimon::menumusic::toolfetch;
    auto const stage = std::filesystem::current_path();
    auto const destination = stage / "tool.exe";
    for (auto const* url : {
            "https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp.exe",
            "https://github.com/BtbN/FFmpeg-Builds/releases/latest/download/ffmpeg-master-latest-win64-gpl.zip"}) {
        std::atomic<bool> downloading = false;
        std::vector<Progress> reports;
        int installations = 0, completions = 0;
        bool succeeded = false;
        std::string result;
        FetchConfig config;
        config.url = url;
        config.minBytes = 1024;
        config.unsupportedMessage = "Unsupported platform";
        config.httpErrorFor = [](int code) { return "Download failed: " + std::to_string(code); };
        config.sizeErrorFor = [](std::size_t bytes) { return "Too small: " + std::to_string(bytes); };
        ProgressCallback onProgress = [&](Progress value) { reports.push_back(std::move(value)); };
        CompleteCallback onComplete = [&](bool ok, std::string message) {
            ++completions;
            succeeded = ok;
            result = std::move(message);
        };
        auto install = [&](geode::ByteVector bytes, auto progress, auto complete) {
            assert(bytes.size() == 1024);
            ++installations;
            if (*progress) (*progress)({"done", 1.f, "Installed"});
            if (*complete) (*complete)(true, "tool.exe");
        };
        auto start = [&](FetchConfig value, bool installed = false) {
            fetchToolBinary<Progress>(std::move(value), destination, installed, stage,
                downloading, onProgress, onComplete, install);
        };

        start(config);
        assert(WebHelper::requestedUrl == url && "The request must retain the release URL");
        assert(downloading && completions == 0);
        geode::Loader::get()->flush();
        WebHelper::progress({});
        geode::Loader::get()->flush();
        assert(reports.back().stage == "downloading");
        assert(reports.back().percent > 0.f && reports.back().percent < 1.f);
        start(config);
        geode::Loader::get()->flush();
        assert(completions == 1 && !succeeded && downloading);
        WebHelper::respond(200, 1024);
        assert(!downloading && installations == 1 && completions == 2 && succeeded);
        assert(result == "tool.exe");

        start(config);
        geode::Loader::get()->flush();
        WebHelper::respond(-3, 0);
        assert(!downloading && !succeeded && result == "Download failed: -3");
        assert(installations == 1);
        start(config);
        geode::Loader::get()->flush();
        WebHelper::respond(404, 0);
        assert(!downloading && !succeeded && result == "Download failed: 404");
        start(config);
        geode::Loader::get()->flush();
        WebHelper::respond(200, 64);
        assert(!downloading && !succeeded && result == "Too small: 64" && installations == 1);

        start(config, true);
        assert(!downloading);
        geode::Loader::get()->flush();
        assert(succeeded && result == paimon::paths::toUtf8(destination));
        config.url.clear();
        start(config);
        geode::Loader::get()->flush();
        assert(!downloading && !succeeded && result == "Unsupported platform");
    }
}
