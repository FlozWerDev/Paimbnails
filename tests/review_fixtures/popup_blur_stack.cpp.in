#include <cassert>
#include <functional>
#include <unordered_map>
#include <vector>

struct CCNode {
    CCNode* parent = nullptr;
    bool visible = true;
    int z = 0;
    unsigned order = 0;
    CCNode* getParent() const { return parent; }
    bool isVisible() const { return visible; }
    void setVisible(bool value) { visible = value; }
    int getZOrder() const { return z; }
    unsigned getOrderOfArrival() const { return order; }
    void removeFromParent() { parent = nullptr; }
    void stopAllActions() {}
    void runAction(int) {}
};
template<class T> struct Ref {
    T* ptr = nullptr;
    Ref(T* value = nullptr) : ptr(value) {}
    T* data() const { return ptr; }
    explicit operator bool() const { return ptr != nullptr; }
};
template<class T> struct WeakRef {
    T* ptr = nullptr;
    WeakRef(T* value = nullptr) : ptr(value) {}
    Ref<T> lock() const { return Ref<T>(ptr); }
    bool valid() const { return ptr != nullptr; }
};
struct RegistryEntry {
    Ref<CCNode> blurRef;
    WeakRef<CCNode> blurWeak, parentWeak;
    float ageSeconds = 0.f;
    bool fadingOut = false;
};
