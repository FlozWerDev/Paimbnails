namespace fs=std::filesystem;
inline fs::path fixtureRoot;
struct Project {
 std::string id,name;int type=0;long long createdAt=0,modifiedAt=0,lastBuiltAt=0;
 bool hasBuiltOnce=false,liveRendering=true;
};
inline long long nowUnixMs(){return 100;}
namespace matjson {
struct Value {
 std::string serialized;
 explicit Value(Project const&p):serialized(p.id+":"+p.name){}
 std::string dump()const{return serialized;}
};
}
namespace paimon::file {
inline bool writeAtomically(fs::path const&path,std::string const&text){std::ofstream f(path);f<<text;return bool(f);}
}
struct Entry {std::string id,name;long long modifiedAt=0,createdAt=0;bool hasBuiltOnce=false;};
namespace paimon::icon_maker {
namespace log=geode::log;
using IconProject=Project;using IconIndexEntry=Entry;
constexpr auto kProjectFile="project.json",kImagesDir="images",kOutputDir="output";
struct IconPaths {
 static fs::path slotsDir(){return fixtureRoot/"icons/slots";}
