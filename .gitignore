# ignore everything
*

# keep this file
!.gitignore
!LICENSE

# keep logo.png
!Logo.png

# keep all .md files
!*.md

# keep mod.json
!mod.json

# keep cmakelists.txt
!CMakeLists.txt

# keep src/ and all its contents
!src/
!src/**

# keep regression tests (sources only, not compiled harnesses)
!tests/
!tests/**
tests/**/*.exe
tests/**/__pycache__/
tests/**/*.pyc

# keep resources/ and all its contents
!resources/
!resources/**

# keep .github/ and all its contents
!.github/
!.github/**

# keep docs/ and all its contents
!docs/
!docs/**

# private / local-only: do not publish servers or reverse-engineering notes
betteredit-reference.md
cloudflare-server/
collab-editor-render/

# keep installer/ scripts only (not binaries)
!installer/
!installer/**
installer/*.exe
installer/*.geode
installer/banner.bmp

