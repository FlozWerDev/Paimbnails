namespace gd { using string = std::string; }
template<class T> struct Ref {
    T* pointer = nullptr;
    Ref(T* value = nullptr) : pointer(value) {}
    Ref& operator=(T* value) { pointer = value; return *this; }
    T* data() const { return pointer; }
    operator T*() const { return pointer; }
};
namespace geode { template<class T> using Ref = ::Ref<T>; }
struct LevelId {
    int number = 0;
    int value() const { return number; }
    LevelId& operator=(int value) { number = value; return *this; }
    operator int() const { return number; }
};
enum class GJDifficulty { NA };
namespace paimon {
bool insideWorker = false;
bool isRuntimeShuttingDown() { return false; }
struct ThreadTracker {
    std::vector<std::function<void()>> workers;
    static ThreadTracker& get() { static ThreadTracker tracker; return tracker; }
    template<class F> bool spawn(F&& fn) { workers.push_back(std::forward<F>(fn)); return true; }
};
}
struct Loader {
    std::vector<std::function<void()>> main;
    static Loader* get() { static Loader loader; return &loader; }
    template<class F> void queueInMainThread(F&& fn) { main.push_back(std::forward<F>(fn)); }
};
void drain() {
    while (!paimon::ThreadTracker::get().workers.empty() || !Loader::get()->main.empty()) {
        auto workers = std::move(paimon::ThreadTracker::get().workers);
        paimon::ThreadTracker::get().workers.clear();
        paimon::insideWorker = true;
        for (auto& fn : workers) fn();
        paimon::insideWorker = false;
        auto callbacks = std::move(Loader::get()->main);
        Loader::get()->main.clear();
        for (auto& fn : callbacks) fn();
    }
}
struct GJGameLevel {
    LevelId m_levelID;
    std::string m_levelString, m_songIDs, m_sfxIDs, m_levelName, m_creatorName;
    int m_audioTrack = 0, m_songID = 0, m_levelLength = 0;
    GJDifficulty m_difficulty = GJDifficulty::NA;
    int m_ratings = 0, m_ratingsSum = 0, m_demonDifficulty = 0;
    int m_coins = 0, m_featured = 0, m_isEpic = 0;
    LevelId m_demon, m_stars;
    bool m_autoLevel = false;
    bool m_levelNotDownloaded = true;
    static GJGameLevel* create() {
        assert(!paimon::insideWorker);
        static std::vector<std::unique_ptr<GJGameLevel>> owned;
        owned.push_back(std::make_unique<GJGameLevel>());
        return owned.back().get();
    }
};
struct LevelDownloadDelegate {
    virtual void levelDownloadFinished(GJGameLevel*) {}
    virtual void levelDownloadFailed(int) {}
};
struct GameLevelManager {
    std::unordered_map<int, GJGameLevel*> saved;
    LevelDownloadDelegate* m_levelDownloadDelegate = nullptr;
    std::vector<int> network;
    static GameLevelManager* get() { static GameLevelManager glm; return &glm; }
    GJGameLevel* getSavedLevel(int id) { auto it = saved.find(id); return it == saved.end() ? nullptr : it->second; }
    void downloadLevel(int id, bool, int) { network.push_back(id); }
};
struct Mod {
    std::filesystem::path directory;
    static Mod* get() { static Mod mod; return &mod; }
    std::filesystem::path getSaveDir() const { return directory; }
};
namespace geode::log { template<class... Args> void warn(char const*, Args&&...) {} }
using namespace geode;
namespace paimon::officialslots {
