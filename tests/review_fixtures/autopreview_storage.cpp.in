namespace fs=std::filesystem;
namespace geode::utils {
namespace string {
std::string pathToString(fs::path const& path) { auto utf8=path.u8string();return {utf8.begin(),utf8.end()}; }
}
struct ParsedInteger {
    int value=0;bool valid=false;
    bool isOk()const{return valid;}int unwrap()const{return value;}
};
template<class T> ParsedInteger numFromString(std::string const& value) {
    T number{};auto result=std::from_chars(value.data(),value.data()+value.size(),number);
    return {static_cast<int>(number),result.ec==std::errc{}&&result.ptr==value.data()+value.size()};
}
}
struct Mod {
    fs::path saveDir;
    static Mod* get(){static Mod mod;return &mod;}
    fs::path getSaveDir()const{return saveDir;}
};
inline auto guiThread=std::this_thread::get_id();
namespace cocos2d {struct CCTexture2D {int releases=0;void release(){assert(std::this_thread::get_id()==guiThread);++releases;}};}
namespace paimon::autopreview {
namespace log {
template<class...T>void error(T const&...){}
template<class...T>void info(T const&...){}
}
struct RGBHeader {uint32_t width,height;};
constexpr uint64_t kMaxRgbPixels=16ull*1024*1024;
using Texture=cocos2d::CCTexture2D;
struct AutoPreviewStore {
    std::mutex m_mutex;bool m_scanned=false;std::unordered_set<int32_t>m_present,m_staleTextures;
    std::mutex m_texMutex;std::unordered_map<int32_t,Texture*>m_texCache;std::deque<int32_t>m_texLru;
    Texture* cachedTexture(int32_t);
    fs::path dir()const;
    fs::path pathFor(int32_t)const;
    void ensureScanned();
    bool has(int32_t);
    bool save(int32_t,uint8_t const*,uint32_t,uint32_t);
};
@@function|src/features/auto-preview/services/AutoPreviewStore.cpp|std::filesystem::path AutoPreviewStore::dir@@
@@function|src/features/auto-preview/services/AutoPreviewStore.cpp|cocos2d::CCTexture2D* AutoPreviewStore::cachedTexture@@
@@function|src/features/auto-preview/services/AutoPreviewStore.cpp|std::filesystem::path AutoPreviewStore::pathFor@@
