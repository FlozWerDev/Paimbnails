@@function|src/features/thumbnails/ui/LocalThumbnailViewPopup.cpp|void LocalThumbnailViewPopup::setChromeVisible(@@
@@function|src/features/thumbnails/ui/LocalThumbnailViewPopup.cpp|void LocalThumbnailViewPopup::tickFocus(@@

bool near(float a, float b) { return std::abs(a - b) < 0.0001f; }
bool near(CCPoint a, CCPoint b) { return near(a.x, b.x) && near(a.y, b.y); }
int main() {
    CCNode main, clip, stencil, border, backdrop, image, menu, sidebar, info, magnifier, other, previous, next;
    main.size = {400.f, 232.f};
    image.size = {1280.f, 720.f};
    image.position = {135.f, 82.f};
    image.scale = 0.35f; // preserve a user's panned/zoomed view on return
    info.size = {244.f, 26.f};
    magnifier.position = {332.f, 212.f};
    other.position = {288.f, 212.f};
    LocalThumbnailViewPopup popup;
    popup.m_mainLayer = &main; popup.m_clippingNode = &clip;
    popup.m_imageStencil = &stencil; popup.m_imageBorder = &border; popup.m_imageBackdrop = &backdrop;
    popup.m_thumbnailSprite = &image; popup.m_buttonMenu = &menu; popup.m_sidebarBg = &sidebar;
    popup.m_infoBar = &info; popup.m_hideChromeBtn = &magnifier;
    popup.m_leftArrow = &previous; popup.m_rightArrow = &next; popup.m_thumbnails = {1, 2};
    popup.m_headerButtonPoses = {{&magnifier, magnifier.position}, {&other, other.position}};
    auto const originalPosition = image.position;
    float const originalScale = image.scale;
    popup.setChromeVisible(false);
    popup.tickFocus(0.12f);
    assert(clip.size.width > 294.f && clip.size.width < 380.f);
    assert(magnifier.position.x > 332.f && magnifier.position.x < 378.f);
    assert(menu.opacity > 0.f && menu.opacity < 1.f && !menu.enabled);
    auto const midwayImage = image.position;
    auto const midwayButton = magnifier.position;
    popup.setChromeVisible(true);
    assert(near(image.position, midwayImage) && near(magnifier.position, midwayButton));
    popup.tickFocus(0.32f);
    assert(near(image.position, originalPosition) && near(image.scale, originalScale));
    assert(near(magnifier.position, {332.f, 212.f}) && near(other.position, {288.f, 212.f}));
    assert(menu.visible && menu.enabled && near(menu.opacity, 1.f));

    popup.setChromeVisible(false);
    popup.tickFocus(0.32f);
    assert(near(clip.size.width, 380.f) && near(clip.size.height, 212.f));
    assert(image.scale > originalScale && near(magnifier.position, {378.f, 212.f}));
    assert(!menu.visible && !sidebar.visible && !info.visible && !previous.visible && !next.visible);
    assert(magnifier.visible && magnifier.enabled);
    image.position = {170.f, 100.f}; image.scale *= 1.4f; // interaction in focused mode
    auto const focusedPosition = image.position;
    popup.setChromeVisible(true);
    assert(near(image.position, focusedPosition));
    popup.tickFocus(0.32f);
    assert(near(image.position, originalPosition) && near(image.scale, originalScale));

    popup.m_thumbnailSprite = nullptr;
    popup.setChromeVisible(false);
    popup.tickFocus(0.32f);
    popup.setChromeVisible(true);
    popup.tickFocus(0.32f);
    assert(menu.visible && near(magnifier.position, {332.f, 212.f}));
}
