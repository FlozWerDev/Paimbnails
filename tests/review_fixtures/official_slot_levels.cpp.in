struct LevelId {
    int number = 0;
    int value() { return number; }
    LevelId& operator=(int id) { number = id; return *this; }
};
struct GJGameLevel {
    LevelId m_levelID;
    std::string m_levelString;
    int m_audioTrack = 0, m_songID = 0, m_levelLength = 0;
    std::string m_songIDs, m_sfxIDs;
    bool m_levelNotDownloaded = true;
};
template<class T> struct Ref {
    T* pointer = nullptr;
    Ref() = default;
    Ref(T* value) : pointer(value) {}
    T* data() const { return pointer; }
    operator T*() const { return pointer; }
    explicit operator bool() const { return pointer != nullptr; }
};
namespace paimon::modules {
bool enabled = true;
bool isEnabled(char const*) { return enabled; }
}
namespace paimon::officialslots {
bool isOfficialId(int id) { return id >= 1 && id <= 22; }
class SlotStore {
public:
    std::unordered_map<std::string, Slot> slots;
    static SlotStore& get() { static SlotStore store; return store; }
    std::optional<Slot> find(std::string const& id) {
        auto it = slots.find(id);
        return it == slots.end() ? std::nullopt : std::optional(it->second);
    }
    std::optional<Slot> slotForOfficial(int id) {
        for (auto const& [key, slot] : slots) if (slot.replacesOfficialId == id && slot.enabled) return slot;
        return std::nullopt;
    }
};
void applyDisplayFields(GJGameLevel*, Slot const&) {}
