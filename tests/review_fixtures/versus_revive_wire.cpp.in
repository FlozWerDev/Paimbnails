struct StateMsg {StateKind kind=StateKind::Ready; uint8_t value=0; uint16_t detail=0; float levelTime=0;};
void putU16(std::vector<uint8_t>& out,uint16_t v){out.push_back(v&255);out.push_back(v>>8);}
uint16_t readU16(std::span<uint8_t const> data,size_t at){return data[at]|(data[at+1]<<8);}
uint16_t clampU16(float v,float s){return static_cast<uint16_t>(std::clamp(v*s,0.f,65535.f));}
