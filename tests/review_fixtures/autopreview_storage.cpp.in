}
int main(){
    using namespace paimon::autopreview;
    auto root=fs::current_path()/paimon::storage::newProjectId();
    assert(root.is_absolute()&&root.parent_path()==fs::current_path());
    Mod::get()->saveDir=root/fs::path(u"usuario-\u00f1-\u4e2d");
    AutoPreviewStore unicode;
    bool unicodePreserved=unicode.dir()==Mod::get()->saveDir/"auto-previews";
    std::cout<<"Unicode path preserved: "<<unicodePreserved<<std::endl;
    Mod::get()->saveDir=root/"ascii";
    AutoPreviewStore store;
    std::vector<uint8_t>a(64*64*4,0x11),b(a.size(),0xee);
    std::atomic<int> failures{0};
    auto write=[&](auto const& pixels){for(int i=0;i<64;++i)if(!store.save(71,pixels.data(),64,64))++failures;};
    std::thread writer([&]{write(a);});write(b);writer.join();
    auto file=store.pathFor(71);std::ifstream stream(file,std::ios::binary);
    std::vector<uint8_t> bytes{std::istreambuf_iterator<char>(stream),{}};
    stream.close();
    bool intact=bytes.size()==sizeof(RGBHeader)+64*64*3;
    if(intact){
        auto first=bytes[sizeof(RGBHeader)];intact=first==0x11||first==0xee;
        intact=intact&&std::all_of(bytes.begin()+sizeof(RGBHeader),bytes.end(),[&](uint8_t value){return value==first;});
    }
    std::cout<<"Concurrent write failures: "<<failures<<"; intact final payload: "<<intact<<std::endl;
    (void)store.cachedTexture(71);
    Texture oldTexture;store.m_texCache[71]=&oldTexture;store.m_texLru.push_back(71);
    bool saved=false;std::thread replace([&]{saved=store.save(71,a.data(),64,64);});replace.join();
    assert(saved && oldTexture.releases==0);
    bool refreshed=store.cachedTexture(71)==nullptr && oldTexture.releases==1;
    std::cout<<"Old GPU texture invalidated after save: "<<refreshed<<std::endl;
#ifdef _WIN32
    Texture currentTexture;store.m_texCache[71]=&currentTexture;store.m_texLru.push_back(71);
    std::ifstream locked(file,std::ios::binary);assert(locked);
    assert(!store.save(71,b.data(),64,64));
    assert(store.cachedTexture(71)==&currentTexture && currentTexture.releases==0);
    locked.close();store.m_texCache.clear();store.m_texLru.clear();
#endif
    fs::remove_all(root);
    assert(refreshed);assert(unicodePreserved);assert(failures==0);assert(intact);assert(store.has(71));
}
