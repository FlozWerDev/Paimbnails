int main() {
    using namespace paimon::transitions::dynamic;
    // The editor's destruction is what signals GJGameLoadingLayer to load gameplay.
    for (int input = 0; input < 4; ++input) {
        bool gameplayLoaded = false;
        auto* editor = new CCScene(&gameplayLoaded);
        CCDirector::get()->scene = editor;
        CCMenuItem saveAndPlay;
        saveAndPlay.parent = editor;
        if (input == 3) {
            holdInput::beginHold(17);
            holdInput::resetHold();
        } else if (input == 2) {
            beginBackInput();
            assert(hasBackInput());
            endBackInput();
            Loader::get()->flush();
        } else {
            captureButton(&saveAndPlay);
            Rect origin;
            bool back = true;
            assert(currentButton(editor, origin, back));
            if (input == 0) { deferDiscardButton(); Loader::get()->flush(); }
            else clearHistory();
        }
        CCDirector::get()->scene = nullptr;
        editor->release();
        assert(gameplayLoaded && "input bookkeeping retained the editor and blocked loading");
        clearHistory();
    }
    // An allocator may reuse a scene address. Cocos object IDs distinguish it.
    alignas(CCScene) unsigned char storage[sizeof(CCScene)];
    auto* oldScene = new (storage) CCScene();
    paimon::SceneIdentity oldIdentity(oldScene);
    assert(oldIdentity.matches(oldScene));
    oldScene->~CCScene();
    auto* newScene = new (storage) CCScene();
    assert(!oldIdentity.matches(newScene));
    assert(!oldIdentity.matches(nullptr));
    newScene->~CCScene();
    std::cout << "PASS: button/back/hold bookkeeping releases the editor for Save and Play\n";
}
