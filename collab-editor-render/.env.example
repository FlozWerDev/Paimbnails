# Copy to .env for local dev (Render reads these from the dashboard instead).
COLLAB_MAX_PEERS=10
COLLAB_MAX_ROOMS=100
COLLAB_MAX_OBJECTS=50000
COLLAB_MAX_ROOM_BYTES=33554432
COLLAB_MAX_SAVE_BYTES=65536
COLLAB_MAX_QUEUE_BYTES=8388608
COLLAB_MAX_OP_BYTES_PER_SEC=8388608
PORT=10000

# Self-ping keep-alive. On Render this defaults to RENDER_EXTERNAL_URL.
# Leave empty for local dev so the server doesn't ping itself.
KEEP_ALIVE_URL=
KEEP_ALIVE_INTERVAL_MS=600000
