}
std::string readFile(fs::path const& path) { std::ifstream stream(path); return {std::istreambuf_iterator<char>(stream),{}}; }
int main() {
    using namespace paimon::icon_maker;
    fixtureRoot=fs::current_path()/paimon::storage::newProjectId();
    assert(fixtureRoot.is_absolute() && fixtureRoot.parent_path()==fs::current_path());
    fs::create_directories(fixtureRoot/"output");
    for(auto const& suffix:{"-uhd","-hd",""}) {
        for(auto const& extension:{".png",".plist"}) {
            std::ofstream stream(fixtureRoot/"output"/("icon"+std::string(suffix)+extension));stream<<"previous";
        }
    }
    auto failed=IconCompiler::compile(IconProject{});
    assert(!failed);
    for(auto const& suffix:{"-uhd","-hd",""}) {
        for(auto const& extension:{".png",".plist"}) {
            assert(readFile(fixtureRoot/"output"/("icon"+std::string(suffix)+extension))=="previous");
        }
    }
    failHd=false;
    {
        auto compiled=IconCompiler::compile(IconProject{});assert(compiled);
        auto output=compiled.unwrap();
        assert(output.staging && readFile(fixtureRoot/"output/icon-uhd.png")=="previous");
        assert(readFile(output.uhd.png)=="new");
        std::error_code error;
        assert(output.staging->publishTo(fixtureRoot/"output",error));
        assert(readFile(fixtureRoot/"output/icon-uhd.png")=="new");
        output.staging->commit();
    }
    assert(fs::is_empty(fixtureRoot/"build-staging"));
    fs::remove_all(fixtureRoot);
    std::cout<<"Failed or unpublished renders preserve output; successful sets publish together\n";
}
