int main() {
    root=std::filesystem::current_path()/(
        "animate-fixture-"+std::to_string(std::chrono::steady_clock::now().time_since_epoch().count()));
    assert(root.parent_path()==std::filesystem::current_path());
    auto first=std::make_unique<GJGameLevel>();
    GJGameLevel second;
    first->m_levelID=100;second.m_levelID=200;
    auto const originalKey=levelKey(first.get());
    assert(originalKey!=levelKey(&second));
    first->m_levelName="Renamed";
    assert(originalKey==levelKey(first.get()));
    auto const savedIdentity=first->identity->text;
    saveDocument(originalKey,{{10,20}});
    GJGameLevel clone;
    restoreLevelIdentity(&clone,savedIdentity);
    auto cloneKey=levelKey(&clone);
    assert(cloneKey!=originalKey && loadDocument(cloneKey).clips==std::vector<int>({10,20}));
    saveDocument(cloneKey,{{30}});
    assert(loadDocument(originalKey).clips==std::vector<int>({10,20}));
    first.reset();
    GJGameLevel reopened;
    restoreLevelIdentity(&reopened,savedIdentity);
    assert(levelKey(&reopened)==originalKey);
    GJGameLevel copied;
    copyLevelDocument(&reopened,&copied);
    assert(levelKey(&copied)!=originalKey && loadDocument(levelKey(&copied)).clips.size()==2);
    GJGameLevel untrusted;
    restoreLevelIdentity(&untrusted,"../../escape");
    assert(validIdentity(untrusted.identity->text));
    GJGameLevel legacy;
    legacy.m_levelName="Unique legacy";
    LocalLevelManager::get()->levels={&legacy};
    auto legacyKey=legacyLevelKey(&legacy);
    saveDocument(legacyKey,{{42}});
    assert(loadLevelDocument(&legacy).clips==std::vector<int>({42}));
    assert(std::filesystem::exists(pathFor(legacyKey)));
    saveDocument(levelKey(&legacy),{});
    assert(loadLevelDocument(&legacy).clips.empty());
    GJGameLevel ambiguousA,ambiguousB;
    LocalLevelManager::get()->levels={&ambiguousA,&ambiguousB};
    saveDocument(legacyLevelKey(&ambiguousA),{{99}});
    assert(loadLevelDocument(&ambiguousA).clips.empty());
    assert(std::filesystem::exists(pathFor(legacyLevelKey(&ambiguousA))));
}
