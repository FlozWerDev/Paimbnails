# Ignore everything
*

# Keep this file
!.gitignore

# Keep Logo.png
!Logo.png

# Keep all .md files
!*.md

# Keep mod.json
!mod.json

# Keep CMakeLists.txt
!CMakeLists.txt

# Keep src/ and all its contents
!src/
!src/**

# Keep regression tests (sources only, not compiled harnesses)
!tests/
!tests/**
tests/**/*.exe

# Keep resources/ and all its contents
!resources/
!resources/**

# Keep .github/ and all its contents
!.github/
!.github/**

# Private / local-only: do not publish servers or reverse-engineering notes
betteredit-reference.md
cloudflare-server/
collab-editor-render/

# Keep installer/ scripts only (not binaries)
!installer/
!installer/**
installer/*.exe
installer/*.geode
installer/banner.bmp

# Exclude AI/agent config files
AGENTS.md
CLAUDE.md
post.md
.kiro/
.ai-style-rules.md

# Local analysis reports, not part of the mod
informe_memcheck.md
