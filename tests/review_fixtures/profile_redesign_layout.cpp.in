@@source|src/features/profile-redesign/services/ProfileLayout.hpp@@
constexpr char const* operator""_spr(char const* value, std::size_t) { return value; }
struct Point { float x = 0, y = 0; };
struct Size { float width = 30, height = 30; };
namespace cocos2d {
struct CCNode {
    virtual ~CCNode() = default;
    std::string id;
    CCNode* parent = nullptr;
    std::vector<CCNode*> children;
    std::unordered_map<std::string, CCNode*> objects;
    bool visible = true;
    Point position;
    Size size;
    float scale = 1;
    std::string_view getID() { return id; }
    auto* getChildren() { return &children; }
    CCNode* getParent() { return parent; }
    bool hasAncestor(CCNode* value) {
        for (auto* p = parent; p; p = p->parent) if (p == value) return true;
        return false;
    }
    void addChild(CCNode* node) { children.push_back(node); node->parent = this; }
    CCNode* getChildByID(std::string const& key) {
        for (auto* child : children) if (child->id == key) return child;
        return nullptr;
    }
    void setUserObject(std::string const& key, CCNode* node) { objects[key] = node; }
    CCNode* getUserObject(std::string const& key) {
        auto found = objects.find(key);
        return found == objects.end() ? nullptr : found->second;
    }
    bool isVisible() { return visible; }
    void setVisible(bool value) { visible = value; }
    Size getContentSize() { return size; }
    void setContentSize(Size value) { size = value; }
    void setScale(float value) { scale = value; }
    void setPosition(Point value) { position = value; }
};
struct CCLayer : CCNode {};
struct CCMenu : CCNode { void setLayout(std::nullptr_t) {} };
struct CCString : CCNode {
    static std::vector<std::unique_ptr<CCString>> arena;
    std::string value;
    static CCString* create(std::string text) {
        auto object = std::make_unique<CCString>();
        object->value = std::move(text);
        arena.push_back(std::move(object));
        return arena.back().get();
    }
    char const* getCString() { return value.c_str(); }
};
std::vector<std::unique_ptr<CCString>> CCString::arena;
}
using namespace cocos2d;
struct CCMenuItemSpriteExtra : CCNode { float m_baseScale = 1; };
struct GJCommentListLayer : CCNode {};
template<class To, class From> To typeinfo_cast(From* value) { return dynamic_cast<To>(value); }
template<class T> struct CCArrayExt {
    std::vector<CCNode*>* nodes;
    CCArrayExt(std::vector<CCNode*>* value) : nodes(value) {}
    auto begin() const { return nodes->begin(); }
    auto end() const { return nodes->end(); }
};
using paimon::profile_redesign::ProfileRect;
