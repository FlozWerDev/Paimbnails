@@function|src/features/official-slots/services/SlotLevels.cpp|void openSlotLevel(@@
@@function|src/features/official-slots/services/SlotLevels.cpp|bool returnFromSlotLevel(@@
}

int main() {
    using namespace paimon::officialslots;
    Slot slot;
    slot.id = "custom";
    slot.levelId = 123456;
    SlotStore::get().slots[slot.id] = slot;
    SlotLevelCache::get().level.m_levelString = "level payload";
    auto* director = CCDirector::get();
    openSlotLevel(slot);
    assert(director->replacements == 0 && FMODAudioEngine::sharedEngine()->preloads == 1);
    paimon::nextFrame();
    assert(director->replacements == 1 && director->pushes == 0 && director->running->kind == 2);
    assert(PlayLayer::last == &SlotLevelCache::get().level);
    assert(AudioContextCoordinator::get().starts == 1);
    assert(returnFromSlotLevel(PlayLayer::last));
    assert(director->running != &director->origin && director->running->kind == 3);
    assert(LevelSelectLayer::requestedPage == 0 && selectedVisiblePage == 4);
    assert(!returnFromSlotLevel(PlayLayer::last));
    assert(!AudioContextCoordinator::get().isGameplayActive());
    // Native LevelSelectLayer has no registered onEnter hook: a successful
    // return must allow another click without a simulated lifecycle reset.
    openSlotLevel(slot);
    assert(paimon::deferred.size() == 1);
    paimon::nextFrame();
    assert(director->replacements == 3 && AudioContextCoordinator::get().starts == 2);
    assert(returnFromSlotLevel(PlayLayer::last));

    auto reset = [&] {
        director->running = &director->origin;
        director->pushes = 0;
        director->replacements = 0;
        *FMODAudioEngine::sharedEngine() = {};
        GameManager::get()->m_sceneEnum = 4;
        paimon::deferred.clear();
        AudioContextCoordinator::get() = {};
        SlotDownloads::get().callbacks.clear();
        ProfileMusicManager::get().callbacks.clear();
        SlotLevelCache::get().level = {};
        SlotLevelCache::get().level.m_levelString = "level payload";
        SlotStore::get().slots[slot.id] = slot;
        MusicDownloadManager::sharedState()->downloaded = true;
        PlayLayer::fail = false;
    };
    GJGameLevel downloaded;
    downloaded.m_levelString = "downloaded payload";
    reset();
    SlotLevelCache::get().level.m_levelString.clear();
    openSlotLevel(slot);
    assert(SlotDownloads::get().callbacks.size() == 1 && director->pushes == 0);
    SlotDownloads::get().callbacks[0](&downloaded);
    paimon::nextFrame();
    assert(director->replacements == 1 && director->running->kind == 2);
    assert(PlayLayer::last->m_levelString == "downloaded payload");

    reset();
    SlotLevelCache::get().level.m_levelString.clear();
    openSlotLevel(slot);
    director->running = &director->elsewhere;
    SlotDownloads::get().callbacks[0](&downloaded);
    assert(director->pushes == 0); // Leaving the scene cancels a delayed play.

    reset();
    SlotLevelCache::get().level.m_songID = 789;
    MusicDownloadManager::sharedState()->downloaded = false;
    openSlotLevel(slot);
    assert(ProfileMusicManager::get().callbacks.size() == 1 && director->pushes == 0);
    ProfileMusicManager::get().callbacks[0](true, "789.mp3");
    paimon::nextFrame();
    assert(director->replacements == 1 && director->running->kind == 2);

    reset();
    SlotLevelCache::get().level.m_songID = 789;
    MusicDownloadManager::sharedState()->downloaded = false;
    openSlotLevel(slot);
    SlotStore::get().slots[slot.id].levelId = 999999;
    ProfileMusicManager::get().callbacks[0](true, "789.mp3");
    assert(director->pushes == 0); // Editing the source cancels the previous play request.

    reset();
    SlotLevelCache::get().level.m_songID = 789;
    MusicDownloadManager::sharedState()->downloaded = false;
    openSlotLevel(slot);
    openSlotLevel(slot);
    ProfileMusicManager::get().callbacks[0](true, "789.mp3");
    assert(director->pushes == 0);
    ProfileMusicManager::get().callbacks[1](true, "789.mp3");
    paimon::nextFrame();
    assert(director->replacements == 1); // Repeated taps still open only one gameplay scene.

    reset();
    openSlotLevel(slot);
    openSlotLevel(slot);
    assert(paimon::deferred.size() == 1); // A staged native entry blocks additional taps.
    director->running = &director->elsewhere;
    paimon::nextFrame();
    assert(director->replacements == 0);
    assert(!AudioContextCoordinator::get().active);
    assert(AudioContextCoordinator::get().context == DynSongLayer::None);

    reset();
    PlayLayer::fail = true;
    openSlotLevel(slot);
    paimon::nextFrame();
    assert(director->pushes == 0 && AudioContextCoordinator::get().aborts == 1);
    assert(!AudioContextCoordinator::get().active);
    assert(GameManager::get()->m_sceneEnum == 4);
    reset();
    OfficialPage original;
    original.m_level = &SlotLevelCache::get().level;
    original.playStep2();
    assert(AudioContextCoordinator::get().starts == 1 && FMODAudioEngine::sharedEngine()->preloads == 1);
    reset();
    downloaded.m_songID = 789;
    cacheSlotLevel(slot);
    assert(SlotDownloads::get().callbacks.size() == 1);
    SlotDownloads::get().callbacks[0](&downloaded);
    assert(ProfileMusicManager::get().callbacks.size() == 1);
    ProfileMusicManager::get().callbacks[0](true, "789.mp3");
    assert(!AudioContextCoordinator::get().active && director->replacements == 0);
    assert(FMODAudioEngine::sharedEngine()->preloads == 0); // Prewarming never starts gameplay/music.
    std::cout << "Direct gameplay: origin return, payload/song downloads, cancellation and failed starts passed\n";
}
