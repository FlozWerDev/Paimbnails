struct PlayLayer : CCNode {
    inline static PlayLayer* current = nullptr;
    bool* destroyed;
    explicit PlayLayer(bool* flag) : destroyed(flag) {}
    ~PlayLayer() override { *destroyed = true; }
    static PlayLayer* get() { return current; }
};
struct PaimonLoadingOverlay : CCNode {};
struct PauseState {
    @@function|src/hooks/PauseLayer.cpp|struct Fields@@;
    Fields fields;
};
namespace paimon {
void setPauseZoomHidden(bool) {}
namespace modules { bool isEnabled(char const*) { return true; } }
}
struct CCPoint { float x, y; };
CCPoint ccp(float x, float y) { return {x, y}; }
namespace cocos { CCPoint getMousePos() { return {}; } }
int zoomResets = 0;
void resetPlayLayerZoom(CCNode*) { ++zoomResets; }
struct PauseZoom {
    decltype(PauseState{}.fields.m_playLayer) m_playLayer;
    bool m_isPaused = false, m_isPanning = false, m_menuForcedHidden = false;
    int m_pauseLayerMissingFrames = 0;
    CCPoint m_lastMousePos{}, m_deltaMousePos{};
    @@function|src/hooks/PlayLayer.cpp|void onPause()@@
    @@function|src/hooks/PlayLayer.cpp|void onResume()@@
    @@function|src/hooks/PlayLayer.cpp|void resetForNewLevel()@@
};
int main() {
    bool destroyed = false;
    auto* play = new PlayLayer(&destroyed);
    PlayLayer::current = play;
    PauseState detachedPause;
    detachedPause.fields.m_playLayer = decltype(detachedPause.fields.m_playLayer){play};
    assert(play->references == 1 && "a retained pause callback must not retain the outgoing gameplay");
    PauseZoom zoom;
    zoom.onPause();
    zoom.onResume();
    assert(zoomResets == 1);
    assert(play->references == 1 && "resetting pause zoom orphaned a pooled gameplay reference");
    zoom.onPause();
    zoom.resetForNewLevel();
    PlayLayer::current = nullptr;
    play->release();
    assert(destroyed && "returning from gameplay must allow its loading-layer handoff");
    zoom.onResume(); // no dereference of the old owner after gameplay destruction

    // A new gameplay may reuse the exact address of the previous owner.
    alignas(PlayLayer) unsigned char storage[sizeof(PlayLayer)];
    bool oldDestroyed = false, newDestroyed = false;
    auto* old = std::construct_at(reinterpret_cast<PlayLayer*>(storage), &oldDestroyed);
    PlayLayer::current = old;
    zoom.onPause();
    std::destroy_at(old);
    auto* replacement = std::construct_at(reinterpret_cast<PlayLayer*>(storage), &newDestroyed);
    PlayLayer::current = replacement;
    int const previousResets = zoomResets;
    zoom.onResume();
    assert(zoomResets == previousResets && "a recycled address does not identify the same gameplay");
    assert(!detachedPause.fields.m_playLayer.matches(replacement));
    std::destroy_at(replacement);
    PlayLayer::current = nullptr;
    std::cout << "Pause owner lifetime checks passed.\n";
}
