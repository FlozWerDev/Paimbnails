using GLubyte = unsigned char;
struct CCSize { float width, height; };
struct CCPoint { float x, y; };
struct Color { unsigned char r, g, b; };
namespace cocos2d { using ccColor3B = Color; }
using cocos2d::ccColor3B;
struct CCTexture2D {
    int references = 1;
    void retain() { ++references; }
    void release() { assert(references > 0); --references; }
};
#define CC_SAFE_RETAIN(pointer) do { if (pointer) (pointer)->retain(); } while (false)
#define CC_SAFE_RELEASE(pointer) do { if (pointer) (pointer)->release(); } while (false)
#define CC_SAFE_RELEASE_NULL(pointer) do { CC_SAFE_RELEASE(pointer); (pointer) = nullptr; } while (false)
struct CCNode : TestLifetime {
    bool visible = true, attached = true;
    virtual ~CCNode() = default;
    void removeFromParent() { attached = false; }
    void setVisible(bool value) { visible = value; }
    void addChild(CCNode* node, int) { node->attached = true; }
    void unschedule(int) {}
    virtual void onExit() {}
};
struct CCSprite : CCNode {
    static std::vector<std::unique_ptr<CCSprite>> pool;
    GLubyte opacity = 255;
    Color color{255, 255, 255};
    CCSize getContentSize() const { return {400, 300}; }
    static CCSprite* createWithTexture(CCTexture2D*) { pool.push_back(std::make_unique<CCSprite>()); return pool.back().get(); }
    void setScale(float) {} void setAnchorPoint(CCPoint) {} void setPosition(CCPoint) {}
    void setOpacity(GLubyte value) { opacity = value; }
    void setColor(Color value) { color = value; }
};
std::vector<std::unique_ptr<CCSprite>> CCSprite::pool;
namespace geode { template<class T> using WeakRef = ::WeakRef<T>; }
namespace paimon::image {
    std::vector<std::function<void(CCTexture2D*)>> requests;
    void loadBudgetedAsync(std::string const&, std::function<void(CCTexture2D*)> callback) { requests.push_back(std::move(callback)); }
}
struct VinylDisc : CCNode {
    CCNode clip, rotating;
    CCNode* m_coverClip = &clip;
    CCNode* m_rotating = &rotating;
    CCSprite* m_coverSprite = nullptr;
    CCTexture2D* m_currentCoverTexture = nullptr;
    std::string m_coverPath;
    std::uint64_t m_coverGeneration = 0;
    bool m_coverLoading = false, m_paused = false;
    float m_radius = 60;
    float m_labelRatio = 0.46f;
    void setCoverFromPath(std::string const&);
    void applyCoverTexture(CCTexture2D*);
    void setPausedAppearance(bool);
    void startSpinning() {} void stopSpinning() {}
};
struct CoverHero : CCNode {
    CCNode clip, fallback;
    CCNode* m_clip = &clip;
    CCNode* m_fallback = &fallback;
    VinylDisc* m_smallDisc = nullptr;
    CCSprite* m_coverSprite = nullptr;
    std::string m_coverPath;
    std::uint64_t m_coverGeneration = 0;
    bool m_coverLoading = false, m_paused = false;
    CCSize m_size{200, 140};
    void setCoverFromPath(std::string const&);
    void applyCoverTexture(CCTexture2D*);
    void setPausedAppearance(bool);
    void onExit() override;
};
