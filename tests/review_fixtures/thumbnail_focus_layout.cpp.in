#include <algorithm>
#include <cassert>
#include <cmath>
#include <vector>

struct CCPoint {
    float x = 0.f, y = 0.f;
    CCPoint operator+(CCPoint point) const { return {x + point.x, y + point.y}; }
    CCPoint operator-(CCPoint point) const { return {x - point.x, y - point.y}; }
    CCPoint operator*(float scale) const { return {x * scale, y * scale}; }
};
struct CCSize { float width = 0.f, height = 0.f; };
struct CCRect {
    CCPoint origin;
    CCSize size;
    CCRect(float x, float y, float width, float height) : origin{x, y}, size{width, height} {}
    float getMidX() const { return origin.x + size.width / 2.f; }
    float getMidY() const { return origin.y + size.height / 2.f; }
};
struct CCNode {
    CCPoint position;
    CCSize size;
    float scale = 1.f, scaleX = 1.f, scaleY = 1.f, opacity = 1.f;
    bool visible = true, enabled = true;
    CCSize getContentSize() const { return size; }
    float getContentWidth() const { return size.width; }
    void setContentSize(CCSize value) { size = value; }
    void setPosition(CCPoint value) { position = value; }
    CCPoint getPosition() const { return position; }
    void setScale(float value) { scale = value; }
    float getScale() const { return scale; }
    void setScaleX(float value) { scaleX = value; }
    void setScaleY(float value) { scaleY = value; }
    void setVisible(bool value) { visible = value; }
    void setEnabled(bool value) { enabled = value; }
    void stopAllActions() {}
    void runAction(int) {}
};
struct CCRGBAProtocol {};
template<class T> T typeinfo_cast(CCNode*) { return nullptr; }
struct CCFadeTo { static int create(float, int) { return 0; } };
struct CCObject {};
using CCMenuItemSpriteExtra = CCNode;
template<class T> struct Ref {
    T* node;
    T* data() const { return node; }
    T* operator->() const { return node; }
    explicit operator bool() const { return node != nullptr; }
};
template<class T> struct WeakRef {
    T* node;
    WeakRef(T* value) : node(value) {}
    Ref<T> lock() const { return {node}; }
};
#define schedule_selector(...) 0
