struct LevelId {
    int number = 1000000001;
    int value() const { return number; }
    operator int() const { return number; }
};
struct GJGameLevel {
    std::string m_levelString, m_songIDs, m_sfxIDs;
    LevelId m_levelID;
    int m_songID = 0, m_audioTrack = 0, m_levelLength = 0;
    bool m_levelNotDownloaded = false;
    std::string getAudioFileName() const { return "custom-song.mp3"; }
};
struct CCScene;
struct BoomScrollLayer {
    int m_page = 27;
    int getRelativePageForNum(int page) { assert(page == 27); return 4; }
};
struct LevelSelectLayer {
    BoomScrollLayer scroll;
    BoomScrollLayer* m_scrollLayer = &scroll;
    static inline int requestedPage = -1;
    static CCScene* scene(int page);
};
struct CCScene {
    int kind = 0;
    LevelSelectLayer* selector = nullptr;
    template<class T> T* getChildByType(int) { return selector; }
};
CCScene* LevelSelectLayer::scene(int page) {
    requestedPage = page;
    static LevelSelectLayer selector;
    static CCScene fresh{3, &selector};
    return &fresh;
}
namespace paimon {
std::vector<std::function<void()>> deferred;
void scheduleMainThreadDelay(float delay, std::function<void()> fn) {
    assert(delay == 0.f);
    deferred.push_back(std::move(fn));
}
void nextFrame() {
    auto ready = std::move(deferred);
    deferred.clear();
    for (auto& fn : ready) fn();
}
}
template<class T> struct Ref {
    T* pointer = nullptr;
    Ref(T* value = nullptr) : pointer(value) {}
    T* data() const { return pointer; }
    T* operator->() const { return pointer; }
    operator T*() const { return pointer; }
};
template<class T> struct WeakRef {
    T* pointer;
    WeakRef(T* value) : pointer(value) {}
    Ref<T> lock() const { return Ref<T>(pointer); }
};
struct CCDirector {
    LevelSelectLayer selector;
    CCScene origin{0, &selector}, elsewhere;
    CCScene* running = &origin;
    int pushes = 0, replacements = 0;
    static CCDirector* get() { static CCDirector director; return &director; }
    CCScene* getRunningScene() const { return running; }
    void pushScene(CCScene* scene) { running = scene; ++pushes; }
    void popScene() { running = &origin; }
    void replaceScene(CCScene* scene) { running = scene; ++replacements; }
};
struct CCTransitionFade { static CCScene* create(float, CCScene* scene) { return scene; } };
struct LevelInfoLayer {
    static CCScene* scene(GJGameLevel*, bool) { static CCScene scene{1}; return &scene; }
};
struct GameManager {
    int m_sceneEnum = 4;
    static GameManager* get() { static GameManager gm; return &gm; }
};
struct FMODAudioEngine {
    int stops = 0, preloads = 0;
    static FMODAudioEngine* sharedEngine() { static FMODAudioEngine engine; return &engine; }
    void stopMusic(int channel) { assert(channel == 0); ++stops; }
    void loadMusic(std::string const& path, float speed, float start, float volume,
                   bool loop, int id, int channel, bool dontReset) {
        assert(path == "custom-song.mp3" && speed == 1.f && start == 0.f && volume == 1.f);
        assert(loop && id == 0 && channel == 0 && !dontReset);
        assert(stops > 0);
        ++preloads;
    }
};
struct PlayLayer {
    static inline bool fail = false;
    static inline GJGameLevel* last = nullptr;
    static CCScene* scene(GJGameLevel* level, bool) {
        assert(FMODAudioEngine::sharedEngine()->preloads > 0);
        assert(GameManager::get()->m_sceneEnum == 9);
        last = level;
        static CCScene scene{2};
        return fail ? nullptr : &scene;
    }
};
enum class DynSongLayer { None, LevelSelect, LevelInfo };
struct AudioContextCoordinator {
    bool active = false;
    DynSongLayer context = DynSongLayer::LevelSelect;
    int starts = 0, aborts = 0;
    static AudioContextCoordinator& get() { static AudioContextCoordinator coordinator; return coordinator; }
    DynSongLayer getDynamicContextLayer() const { return context; }
    bool isGameplayActive() const { return active; }
    void beginGameplayTransition() { active = true; context = DynSongLayer::None; ++starts; }
    void prepareGameplayAudio(GJGameLevel*);
    void abortGameplayTransition(DynSongLayer restored) { active = false; context = restored; ++aborts; }
    void activateLevelSelectLevel(GJGameLevel*) { active = false; context = DynSongLayer::LevelSelect; }
    void activateLevelSelect(int, bool) { active = false; context = DynSongLayer::LevelSelect; }
    void deactivateLevelSelect(bool) { context = DynSongLayer::None; }
};
struct DynamicSongManager {
    int handoffs = 0;
    static DynamicSongManager* get() { static DynamicSongManager manager; return &manager; }
    void cancelGameplayHandoff() {}
    void finishGameplayHandoff(int) { assert(AudioContextCoordinator::get().active); ++handoffs; }
};
@@function|src/features/audio/services/AudioContextCoordinator.cpp|void AudioContextCoordinator::prepareGameplayAudio(@@
struct LevelPage {
    GJGameLevel* m_level = nullptr;
    void playStep2() {
        assert(AudioContextCoordinator::get().active && DynamicSongManager::get()->handoffs > 0);
        // Native preload must run after the preview has released its channel.
        auto* engine = FMODAudioEngine::sharedEngine();
        engine->stopMusic(0);
        engine->loadMusic(m_level->getAudioFileName(), 1.f, 0.f, 1.f, true, 0, 0, false);
    }
};
struct OfficialPage : LevelPage {
    @@function|src/hooks/LevelPage.cpp|void playStep2()@@
};
struct MusicDownloadManager {
    bool downloaded = true;
    static MusicDownloadManager* sharedState() { static MusicDownloadManager manager; return &manager; }
    bool isSongDownloaded(int) const { return downloaded; }
};
struct ProfileMusicManager {
    std::vector<std::function<void(bool, std::string const&)>> callbacks;
    static ProfileMusicManager& get() { static ProfileMusicManager manager; return manager; }
    void downloadSongForPreview(int, std::function<void(bool, std::string const&)> callback) {
        callbacks.push_back(std::move(callback));
    }
};
enum class NotificationIcon { Info, Warning, Error };
struct PaimonNotify { static void show(std::string const&, NotificationIcon) {} };
struct Localization {
    static Localization& get() { static Localization localization; return localization; }
    std::string getString(char const* key) const { return key; }
};
namespace paimon::officialslots {
int selectedVisiblePage = -1;
void selectVisiblePage(LevelSelectLayer* layer, int page) { assert(layer); selectedVisiblePage = page; }
std::uint64_t g_playRequest = 0;
std::optional<int> g_playReturnPage;
GJGameLevel* g_playingLevel = nullptr;
using SlotReadyCallback = std::function<void(GJGameLevel*)>;
struct SlotStore {
    std::unordered_map<std::string, Slot> slots;
    static SlotStore& get() { static SlotStore store; return store; }
    std::optional<Slot> find(std::string const& id) {
        auto it = slots.find(id);
        return it == slots.end() ? std::nullopt : std::optional(it->second);
    }
};
struct SlotLevelCache {
    GJGameLevel level;
    static SlotLevelCache& get() { static SlotLevelCache cache; return cache; }
    GJGameLevel* levelForSlot(Slot const&) { return &level; }
};
struct SlotDownloads {
    std::vector<std::function<void(GJGameLevel*)>> callbacks;
    static SlotDownloads& get() { static SlotDownloads downloads; return downloads; }
    void fetch(int, std::function<void(GJGameLevel*)> callback) { callbacks.push_back(std::move(callback)); }
};
