void write(std::filesystem::path const& path, std::string const& value) {
    std::filesystem::create_directories(path.parent_path()); std::ofstream out(path); out << value;
}
int main() {
    saveRoot = std::filesystem::temp_directory_path() / "paimon-music-cover-async-regression";
    auto& cache = SongCoverCache::get();
    auto root = cache.getCoversDir();
    int callbacks = 0;
    std::vector<std::string> delivered;
    auto result = [&](std::vector<std::string> const& paths, bool success) { ++callbacks; assert(success == !paths.empty()); delivered = paths; };
    cache.requestCachedCoversAsync(42, result);
    cache.requestCachedCoversAsync(42, result);
    assert(workers.size() == 1 && callbacks == 0 && cache.peekCachedCoverPaths(42).empty());
    // Files appear only after the request: the initial call cannot have read them.
    write(root / "42" / "123.png", "image");
    write(root / "42" / "manifest.json", R"({"levelIds":[123],"files":["123.png"],"names":{"123":"Nivel"}})");
    write(root / "negative.json", R"({"999":12345})");
    runJob(workers); assert(callbacks == 0 && mainJobs.size() == 1);
    runJob(mainJobs);
    assert(callbacks == 2 && delivered.size() == 1);
    auto entries = cache.peekCachedCoverEntries(42);
    assert(entries.size() == 1 && entries[0].levelID == 123 && entries[0].name == "Nivel");
    assert(cache.m_negativeMemo && cache.m_negativeMemo->at("999") == 12345.);

    cache.requestCachedCoversAsync(7, result);
    cache.cancelPending(7);
    cache.requestCachedCoversAsync(7, result);
    write(root / "7.gif", "legacy");
    runJob(workers); runJob(mainJobs); assert(callbacks == 2); // closed popup cannot consume an old result
    runJob(workers); runJob(mainJobs); assert(callbacks == 3 && delivered[0].ends_with("7.gif"));

    cache.requestCachedCoversAsync(8, result);
    write(root / "8" / "1.png", "old");
    write(root / "8" / "manifest.json", R"({"files":["1.png"],"names":{"1":"old"}})");
    runJob(workers); // old snapshot is ready but has not reached the UI yet
    write(root / "8" / "2.png", "new");
    cache.saveManifest(8, {2}, {(root / "8" / "2.png").string()}, {{2, "new"}});
    runJob(mainJobs); assert(callbacks == 3 && workers.size() == 1);
    runJob(workers); runJob(mainJobs); assert(callbacks == 4 && delivered[0].ends_with("2.png"));
    assert(cache.peekCachedCoverEntries(8)[0].name == "new");

    auto userCover = (root / "user.png").string();
    SongCoverCache::validateCoverPathsAsync({userCover, (root / "missing.png").string()}, result);
    assert(callbacks == 4 && workers.size() == 1);
    write(userCover, "image");
    runJob(workers); runJob(mainJobs);
    assert(callbacks == 5 && delivered.size() == 1 && delivered[0] == userCover);

    cache.requestCachedCoversAsync(99, result);
    runJob(workers); runJob(mainJobs);
    assert(callbacks == 6 && delivered.empty());
    assert(cache.m_manifestMemo.contains(99) && cache.m_legacyMemo.contains(99));
    assert(cache.getCachedCoverPaths(99).empty());
    std::filesystem::remove(root / "42" / "123.png");
    cache.requestCachedCoversAsync(42, result); // reopening rechecks deleted images off-thread
    assert(workers.size() == 1 && callbacks == 6);
    runJob(workers); runJob(mainJobs);
    assert(callbacks == 7 && delivered.empty() && cache.peekCachedCoverEntries(42).empty());
    auto& tracker = paimon::ThreadTracker::get();
    tracker.reject = true;
    cache.requestCachedCoversAsync(66, result);
    assert(callbacks == 8 && delivered.empty() && !cache.m_pendingDiskLookups.contains(66));
    SongCoverCache::validateCoverPathsAsync({userCover}, result);
    assert(callbacks == 9 && delivered.empty());
    tracker.reject = false; tracker.throwOnSpawn = true;
    cache.requestCachedCoversAsync(67, result);
    assert(callbacks == 10 && delivered.empty() && !cache.m_pendingDiskLookups.contains(67));
    SongCoverCache::validateCoverPathsAsync({userCover}, result);
    assert(callbacks == 11 && delivered.empty());
}
