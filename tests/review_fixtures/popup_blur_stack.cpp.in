@@function|src/blur/PopupBlurService.cpp|static bool parentAlive(@@
@@function|src/blur/PopupBlurService.cpp|static std::unordered_map<CCNode*, RegistryEntry>& blurRegistry()@@
@@function|src/blur/PopupBlurService.cpp|static void updateBlurVisibility()@@

struct Loader {
    std::vector<std::function<void()>> jobs;
    static Loader* get() { static Loader loader; return &loader; }
    void queueInMainThread(std::function<void()> job) { jobs.push_back(std::move(job)); }
    void drain() { for (auto& job : jobs) job(); jobs.clear(); }
};
namespace paimon { bool isRuntimeShuttingDown() { return false; } }
void unscheduleWatchdogIfIdle() {}
struct CCFadeTo { static int create(float, int) { return 0; } };
struct CCCallFunc { static int create(CCNode*, int) { return 0; } };
struct CCSequence { static int create(int, int, void*) { return 0; } };
