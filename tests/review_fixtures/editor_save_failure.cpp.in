int main(){
 IconEditorLayer icon;icon.onBack();assert(CCDirector::get()->pops==0&&IconThumbs::get().invalidations==0);
 icon.saveOkay=true;icon.onBack();assert(CCDirector::get()->pops==1);
 ProjectEditorLayer texture;texture.onBack(nullptr);texture.onOpenFusionLayer();
 assert(CCDirector::get()->pops==1&&FusionEditorLayer::opens==0);
 SlotStore::get().saveOkay=true;texture.onBack(nullptr);texture.onOpenFusionLayer();
 assert(CCDirector::get()->pops==2&&FusionEditorLayer::opens==1);
}
