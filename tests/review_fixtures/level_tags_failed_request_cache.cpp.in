using LevelTagMap=std::unordered_map<int,std::vector<std::string>>;
namespace matjson {
 struct Json{bool object=true;bool isObject()const{return object;}};
 struct Parsed {bool valid=false;Json json;bool isOk()const{return valid;}Json unwrap()const{return json;}};
 Parsed parse(std::string const& text){return {text=="{}" || text=="[]",{text!="[]"}};}
}
namespace web {
 struct WebResponse {
  bool success=false;std::string body;
  bool ok()const{return success;}
  struct String {std::string value;std::string unwrapOr(char const*)const{return value;}};
  String string()const{return {body};}
 };
 struct WebRequest {template<class T>void timeout(T){} void acceptEncoding(char const*){}};
}
struct WebHelper {
 static inline std::vector<std::function<void(web::WebResponse)>> requests;
 static void dispatch(web::WebRequest,std::string,std::string,std::function<void(web::WebResponse)> cb) {
  requests.push_back(std::move(cb));
 }
};
struct LevelTagsClient {
 std::mutex m_mutex; LevelTagMap m_levelTags; bool m_dirty=false;
 static constexpr size_t kFetchChunkSize=50;
 static bool isAvailable(){return true;}
 static std::string serverURL(){return "stub";}
 void fetchTags(std::vector<int>const&,std::function<void(LevelTagMap)>);
 LevelTagMap parseLevelTags(matjson::Json)const{return {};}
 void saveDiskCache(){}
};
