}
int main(){
 fixtureRoot=fs::current_path()/("project-store-"+paimon::storage::newProjectId());
 assert(fixtureRoot.is_absolute()&&fixtureRoot.parent_path()==fs::current_path());
 fs::create_directories(fixtureRoot);{std::ofstream f(fixtureRoot/"outside.txt");f<<"preserved";}
 using namespace paimon::icon_maker;
 IconProjectStore icons;Project seed;seed.id="../../victim";seed.name="Cube";
 auto first=icons.createProject(seed);assert(first);
 seed.id="..";seed.name="cube";auto second=icons.createProject(seed);assert(second&&first.unwrap()!=second.unwrap());
 assert(!fs::equivalent(IconPaths::projectFile(first.unwrap()),IconPaths::projectFile(second.unwrap())));
 seed.name="..";auto dot=icons.createProject(seed);assert(dot&&paimon::storage::isSafeProjectId(dot.unwrap()));
 for(auto invalid:{"..",".","../../victim","C:/outside"})assert(!icons.deleteProject(invalid));
 icons.failIndex=true;assert(!icons.deleteProject(first.unwrap()));
 assert(icons.exists(first.unwrap())&&fs::exists(IconPaths::projectFile(first.unwrap())));
 icons.failIndex=false;assert(icons.deleteProject(first.unwrap()));
 assert(fs::exists(IconPaths::projectFile(second.unwrap())));
 using namespace paimon::texture_studio;
 SlotStore slots;seed.id="../../victim";auto slot=slots.createSlot(seed);assert(slot);
 assert(paimon::storage::isSafeProjectId(slot.unwrap()));
 for(auto invalid:{"..",".","../../victim","C:/outside"})assert(!slots.deleteSlot(invalid));
 slots.failIndex=true;assert(!slots.deleteSlot(slot.unwrap()));assert(slots.exists(slot.unwrap()));
 slots.failIndex=false;assert(slots.deleteSlot(slot.unwrap()));
#ifdef _WIN32
 icons.m_index.push_back({"Legacy"});fs::create_directories(IconPaths::slotDir("Legacy"));
 assert(icons.canonicalId("legacy")=="Legacy");assert(icons.deleteProject("legacy"));assert(!icons.exists("Legacy"));
 slots.m_index.push_back({"Legacy"});fs::create_directories(SlotPaths::slotDir("Legacy"));
 assert(slots.canonicalId("legacy")=="Legacy");assert(slots.deleteSlot("legacy"));assert(!slots.exists("Legacy"));
#endif
 assert(fs::exists(fixtureRoot/"outside.txt"));
 std::cout<<"Project stores preserve sibling data, allocate independent IDs, and roll back index failures\n";
}
