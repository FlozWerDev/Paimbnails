#include "tests/review_fixtures/ReviewQueue.hpp"
#include "tests/review_fixtures/EngineLifetime.hpp"
struct Response { bool isErr()const{return false;} };
// This fixture needs Result<>::isErr, supplied by ReviewQueue's result double.
struct LazySprite {
    bool loading=false,hasLoaded=false,visible=false,attached=true;
    int requests=0;
    std::function<void(Result<void>)> callback;
    static std::vector<std::unique_ptr<LazySprite>> pool;
    static LazySprite* create(std::pair<float,float>){pool.push_back(std::make_unique<LazySprite>());return pool.back().get();}
    bool isLoading(){return loading;}
    void cancelLoad(){loading=false;}
    void removeFromParent(){attached=false;}
    void setVisible(bool v){visible=v;}
    void setLoadCallback(std::function<void(Result<void>)> cb){callback=std::move(cb);}
    void loadFromUrl(std::string const&){if(loading||hasLoaded)return;loading=true;++requests;}
    void complete(){loading=false;hasLoaded=true;if(callback)callback(Ok());}
    float getContentWidth(){return 120;}float getContentHeight(){return 60;}void setScale(float){}
};
std::vector<std::unique_ptr<LazySprite>> LazySprite::pool;
namespace Anchor{constexpr int Center=0;}
struct MainLayer{void addChildAtPosition(LazySprite*,int,std::pair<float,float>){};};
