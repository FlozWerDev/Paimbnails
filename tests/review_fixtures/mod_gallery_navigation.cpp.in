 int m_index=1,m_total=3,m_gen=0;std::string m_base="preview-";
 LazySprite* m_sprite=nullptr;MainLayer layer;MainLayer* m_mainLayer=&layer;
 void openIndex(int);void refreshChrome(){}
};
